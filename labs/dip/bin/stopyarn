#!/usr/bin/env bash

nn="dtm-0"
rs="dtm-1"
w="dtw-0 dtw-1 dtw-2"
yn=5

c=0
for n in $w
do
   if [ "$c" -le "$yn" ]; then
      ssh bigred@$n yarn --daemon stop nodemanager &>/dev/null
      [ "$?" == "0" ] && echo "$n: Node Manager stoped"
      c=$(( c+1 ))
   fi
done

ssh bigred@"$rs" mapred --daemon stop historyserver &>/dev/null
[ "$?" == "0" ] && echo "$rs: Job History Server stoped"
ssh bigred@"$rs" yarn --daemon stop resourcemanager &>/dev/null
[ "$?" == "0" ] && echo "$rs: Resource Manager stoped"
