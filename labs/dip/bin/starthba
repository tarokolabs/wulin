#!/bin/bash

nc -w 5 -z dtm-0 8020 &>/dev/null
[ "$?" != 0 ] && echo "pls start HDFS first" && exit 1

ssh bigred@dtm-2 zkServer.sh start &>/dev/null
[ "$?" == "0" ] && echo "dtm-2: ZooKeeper started"

ssh bigred@dtm-2 hbase-daemon.sh start master &>/dev/null
[ "$?" == "0" ] && echo "dtm-2: Hbase Master started"

#ssh bigred@dtm-2 hbase-daemon.sh start thrift &>/dev/null
#[ "$?" == "0" ] && echo "dtm-2: Hbase Thrift started"

for n in dtw-0 dtw-1 dtw-2
do
   nc -w 3 -z $n 22 &>/dev/null
   if [ "$?" == "0" ]; then
      ssh bigred@$n hbase-daemon.sh start regionserver &>/dev/null
      [ "$?" == "0" ] && echo "$n: Region Server started"
   fi
done

