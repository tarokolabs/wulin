#!/bin/bash

read -p "下載 LKH 套件 ? (YES/NO) " ans
if [ "$ans" == "YES" ]; then

   if [ -d /opt/zfs/sys/ ]; then
      f=$(ls /opt/zfs/sys/)
      [ "$f" != "" ] && echo "LKH package existed" && exit 0
   fi
   sudo mkdir -p /opt/zfs/sys/; sudo chmod 777 /opt/zfs/sys/
   while read line; do
     wget $line &>/dev/null
     if [ "$?" == "0" ]; then
        n=${line##*/}
        tar xvfz $n -C /opt/zfs/sys/ &>/dev/null
        [ "$?" == "0" ] && echo "$n ok"
        rm $n
     else
        n=${line##*/}
        echo "$n failed"
     fi
   done < ~/wulin/wk/dip/bin/lkhlist

   sudo chown -R bigred:wheel /opt/zfs/sys/
fi

echo ""
[ -f ~/wulin/wk/dip/bin/dipconf ] &&  ~/wulin/wk/dip/bin/dipconf

