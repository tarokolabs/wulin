#!/usr/bin/env bash

for n in dtw-0 dtw-1 dtw-2
do
   nc -w 1 -z $n 22 &>/dev/null
   if [ "$?" == "0" ]; then
      ssh bigred@$n hbase-daemon.sh stop regionserver &>/dev/null
      [ "$?" == "0" ] && echo "$n: Region Server stoped"
   fi
done

#ssh bigred@dtm-2 hbase-daemon.sh stop thrift &>/dev/null
#[ "$?" == "0" ] && echo "dtm-2: Hbase Thrift stoped"

ssh bigred@dtm-2 hbase-daemon.sh stop master &>/dev/null
[ "$?" == "0" ] && echo "stm-2: Hbase Master stoped"

ssh bigred@dtm-2 zkServer.sh stop &>/dev/null
[ "$?" == "0" ] && echo "dtm-2: ZooKeeper stoped"
