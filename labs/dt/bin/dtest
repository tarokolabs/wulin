#!/usr/bin/env bash
echo "[HDFS]"
nc -w 1 -z dtm-0 22 &>/dev/null
[ "$?" != 0 ] && echo 'dtm-0 exited' && exit 1
ssh -q dtm-0 jps | grep 'NameNode' &>/dev/null
[ "$?" != 0 ] && echo "HDFS exited" && exit 1
hdfs dfsadmin -report &> /tmp/out 
cat /tmp/out | grep 'Live datanodes'
cat /tmp/out | grep 'Name: '
echo ""

echo "[YARN]"
nc -w 1 -z dtm-1 22 &>/dev/null
[ "$?" != 0 ] && echo 'dtm-1 exited' && exit 1
ssh dtm-1 jps | grep 'ResourceManager' &>/dev/null
[ "$?" != 0 ] && echo "YARN exited" && exit 1
yarn node -list -all 2>/dev/null

echo""
echo [MapReduce]
hadoop jar /opt/zfs/sys/hadoop-3.4.3/share/hadoop/mapreduce/hadoop-mapreduce-examples-3.4.3.jar pi 2 1000 &> /tmp/out
cat /tmp/out | grep ' Pi '

#echo""
#ssh dtm-0 hdfs dfs -ls /tmp/spark-events &>/dev/null
#[ "$?" != "0" ] && ssh dtm-0 hdfs dfs -mkdir /tmp/spark-events && ssh dtm-0 hdfs dfs -chmod -R 777 /tmp
#echo [Spark]
#spark-submit --num-executors 1 --executor-memory 512m \
#/opt/dt/spark-3.5.2-bin-hadoop3/examples/src/main/python/pi.py 10

echo ""
echo [HBase]
nc -w 1 -z dtm-2 22 &>/dev/null
[ "$?" != 0 ] && echo 'dtm-2 exited' && exit 1
ssh dtm-2 jps 2>/dev/null | grep 'HMaster' &>/dev/null
if [ "$?" == "0" ]; then
   echo "status" | hbase shell -n 2>/dev/null | head -n 2
fi
