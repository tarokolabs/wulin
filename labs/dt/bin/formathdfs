#!/bin/bash

m="dtm-0"
zk="dtm-2"
w="dtw-0 dtw-1 dtw-2"

read -p "Are you sure ? (YES/NO) " ans
[ "$ans" != "YES" ] && echo "abort format HDFS" && exit 1

ssh "$m" rm -r nn/* sn/* &>/dev/null
[ "$?" == "0" ] && echo "$m:/home/bigred/{nn,sn} rm ok"

for n in $w
do
   nc -w 1 -z $n 22 &>/dev/null
   [ "$?" == "0" ] && ssh $n rm -r dn/* &>/dev/null && echo "$n:/home/bigred/dn rm ok"
done

ssh "$zk" rm -r zk/* &>/dev/null
[ "$?" == "0" ] && echo "$zk:/home/bigred/zk rm ok"

ssh $m 'hdfs namenode -format -clusterID cute' &>/dev/null
[ "$?" != "0" ] && echo "formathdfs failure" && exit 1
echo "formathdfs ok"
