#!/bin/bash

read -p "下載 LKH 套件 ? (YES/NO) " ans
if [ "$ans" == "YES" ]; then

   if [ -d /opt/zfs/sys/ ]; then
      f=$(ls /opt/zfs/sys/)
      [ "$f" != "" ] && echo "LKH package existed" && exit 0
   fi
   sudo mkdir -p /opt/zfs/sys/; sudo chmod 777 /opt/zfs/sys/
   while read line; do
     wget $line &>/dev/null
     if [ "$?" == "0" ]; then
        n=${line##*/}
        tar xvfz $n -C /opt/zfs/sys/ &>/dev/null
        [ "$?" == "0" ] && echo "$n ok"
        rm $n
     else
        n=${line##*/}
        echo "$n failed"
     fi
   done < ~/wulin/wk/lkh/bin/lkhlist

   sudo chown -R bigred:wheel /opt/zfs/sys/
fi

wget https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.0.33/mysql-connector-j-8.0.33.jar &>/dev/null
if [ "$?" == "0" ]; then
   cp mysql-connector-j-8.0.33.jar /opt/zfs/sys/spark-3.5.5-bin-hadoop3/jars/
   cp mysql-connector-j-8.0.33.jar /opt/zfs/sys/spark-3.4.4-bin-hadoop3/jars/
   [ "$?" == "0" ] && echo "mysql-connector-j-8.0.33.jar (Spark) ok"
fi

wget https://search.maven.org/remotecontent?filepath=org/apache/iceberg/iceberg-spark-runtime-3.5_2.12/1.9.0/iceberg-spark-runtime-3.5_2.12-1.9.0.jar -O  iceberg-spark-runtime-3.5_2.12-1.9.0.jar &>/dev/null
if [ "$?" == "0" ]; then
   mv iceberg-spark-runtime-3.5_2.12-1.9.0.jar /opt/zfs/sys/spark-3.5.5-bin-hadoop3/jars/
   [ "$?" == "0" ] && echo "iceberg-spark-runtime-3.5_2.12-1.9.0.jar ok"
fi

wget https://search.maven.org/remotecontent?filepath=org/apache/iceberg/iceberg-spark-runtime-3.4_2.12/1.9.0/iceberg-spark-runtime-3.4_2.12-1.9.0.jar -O iceberg-spark-runtime-3.4_2.12-1.9.0.jar &>/dev/null
if  [ "$?" == "0" ]; then
    mv iceberg-spark-runtime-3.4_2.12-1.9.0.jar  /opt/zfs/sys/spark-3.4.4-bin-hadoop3/jars/
    [ "$?" == "0" ] && echo "iceberg-spark-runtime-3.4_2.12-1.9.0.jar ok"
fi

echo ""
[ -f ~/wulin/wk/lkh/bin/lkhconf ] &&  ~/wulin/wk/lkh/bin/lkhconf

